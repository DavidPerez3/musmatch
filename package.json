{
  "name": "musmatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:export": "node --test tests/export/*.test.mjs",
    "test:drift": "MUSMATCH_TEST_CLOUD_DRIFT=1 node --test tests/*.test.mjs",
    "test:ui": "node scripts/prepare-browser.mjs && playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.89.0",
    "jsqr": "1.4.0",
    "next": "16.1.1",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
